{
  "name": "zigwheels-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI/API automation framework for zigwheels.com",
  "private": true,
  "author": "QA Automation",
  "license": "UNLICENSED",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test tests/e2e",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "report": "playwright show-report reports/html-report",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "test:bdd": "node scripts/run-bdd.js",
    "test:bdd:smoke": "node scripts/run-bdd.js --tag=@new-bikes-tiles",
    "test:bdd:regression": "node scripts/run-bdd.js --tag=@regression",
    "test:bdd:e2e": "node scripts/run-bdd.js --tag=@e2e",
    "runner": "node scripts/bdd-runner.js",
    "runner:headed": "cross-env HEADLESS=false node scripts/bdd-runner.js",
    "runner:parallel": "node scripts/bdd-runner.js --parallel",
    "test:bdd:headed": "cross-env HEADLESS=false node scripts/run-bdd.js",
    "codegen": "playwright codegen https://www.zigwheels.com",
    "trace": "playwright show-trace",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --noEmit --watch",
    "clean": "rimraf reports test-results",
    "prepare:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "allure-playwright": "^3.3.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
